    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "Carga del feed",
                      "items":  [
                                    "main.dart registra LocalVideoPostDataSource, YouTubeVideoDataSource, PixabayVideoDataSource y VimeoVideoDataSource.",
                                    "VideoPostRepositoryImpl consulta las fuentes en paralelo, intercala resultados, deduplica por id e informa fallos parciales.",
                                    "Lanza VideoDataSourcesException solo si todas las fuentes fallan y no hay videos."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "Estado de las secciones",
                      "items":  [
                                    "DiscoverProvider expone initialLoading, videos, loadError y sourceFailures.",
                                    "For You ordena por vistas y likes; Favorites filtra isFavorite.",
                                    "DiscoverScreen navega horizontalmente; cada seccion se desplaza verticalmente."
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "Metadatos y reproduccion",
                      "items":  [
                                    "La fuente Local lee registros Dart cuyo videoUrl es una URL remota de Google Drive; no lee archivos del dispositivo.",
                                    "FullScreenPlayer usa VideoPlayerController para URLs directas, YouTube IFrame para YouTube y WebView para Vimeo.",
                                    "InstagramVideoDataSource y GoogleDriveVideoDataSource existen, pero no estan registradas. .env.example deja vacias las claves de YouTube/Pixabay y las URLs de Vimeo."
                                ]
                  }
              ]
